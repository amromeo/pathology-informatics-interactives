{
  "name": "pathology-informatics-interactives",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run data:compile && vite --configLoader runner",
    "data:lesson3": "node scripts/generate-lesson3-report.mjs",
    "data:compile": "node scripts/compile-lesson-data.mjs",
    "assets:optimize": "node scripts/optimize-images.mjs",
    "build": "npm run data:compile && tsc --noEmit && vite build --configLoader runner && tsx scripts/export-coverage.ts && node scripts/create-pages-fallback.mjs",
    "build:pages": "npm run data:compile && tsc --noEmit && vite build --base /pathology-informatics-interactives/ --configLoader runner && tsx scripts/export-coverage.ts && node scripts/create-pages-fallback.mjs",
    "preview:pages": "node scripts/serve-pages-build.mjs",
    "test:curriculum": "tsx scripts/validate-curriculum.ts",
    "test:unit": "npm run data:compile && tsx --test tests/*.test.ts tests/*.test.tsx",
    "test": "npm run format:check && npm run lint && npm run test:curriculum && npm run test:unit && npm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{ts,mjs}\" \"tests/**/*.{ts,tsx}\" \"content/lessons/*/*.ts\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.{ts,mjs}\" \"tests/**/*.{ts,tsx}\" \"content/lessons/*/*.ts\" vite.config.ts",
    "lint": "eslint src content tests"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
